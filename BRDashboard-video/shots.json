    {
      "id": "hook",
      "kind": "card",
      "say": "Every year, bovine respiratory disease costs feedlots millions. In treatment. In lost performance. In cattle that never make it."
    },
    {
      "id": "problem",
      "kind": "card",
      "say": "And the people making the calls are doing it with incomplete records and not enough hours in the day."
    },
    {
      "id": "product",
      "kind": "app",
      "say": "BRDashboard is the decision aid that turns cattle health data into a plan a yard manager can actually run.",
      "do": [
        {
          "waitFor": "article.morning-hero h1.hero"
        },
        {
          "waitFor": ".lot-list"
        },
        {
          "settle": 15000
        },
        {
          "cut": true
        },
        {
          "wait": 2600
        },
        {
          "focus": {
            "sel": "article.morning-hero",
            "pad": 420,
            "max": 1.25,
            "ms": 1400
          }
        }
      ]
    },
    {
